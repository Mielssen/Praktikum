            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://localhost:7227/swagger/v1/swagger.json",
          "protocol": "https",
          "host": [ "localhost" ],
          "port": "7227",
          "path": [ "swagger", "v1", "swagger.json" ]
        }
      }
    },
